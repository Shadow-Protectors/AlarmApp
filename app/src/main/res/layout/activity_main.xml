<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_app_logo"
                android:layout_marginEnd="12dp"
                android:contentDescription="@string/cd_app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.02"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline Destination Alert System"
                    android:textSize="11sp"
                    android:letterSpacing="0.04"
                    android:textColor="#93C5FD" />

            </LinearLayout>

            <View
                android:id="@+id/headerLiveDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="@color/text_muted" />

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 1. LIVE TRACKING STATUS CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTrackingStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="8dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/surface_card"
                    android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/statusIndicator"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_status_dot"
                            android:backgroundTint="@color/text_muted"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvStatusHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LIVE STATUS"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.14"
                            android:textColor="@color/text_muted" />

                        <TextView
                            android:id="@+id/tvApproachBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IDLE"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.06"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="3dp"
                            android:textColor="@color/text_muted"
                            android:background="@drawable/bg_badge_rounded" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Ready — Set a destination below"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingExtra="2dp" />

                    <!-- Departure-Board Readout Panel -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="16dp"
                        android:background="@color/surface_elevated"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DISTANCE"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.14"
                                android:textColor="@color/text_muted" />

                            <TextView
                                android:id="@+id/tvDistance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="-- km"
                                android:textSize="34sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_light"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="44dp"
                            android:background="@color/card_stroke"
                            android:layout_marginHorizontal="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ETA"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.14"
                                android:textColor="@color/text_muted" />

                            <TextView
                                android:id="@+id/tvEta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--:--"
                                android:textSize="26sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_primary"
                                android:fontFamily="monospace"
                                android:includeFontPadding="false" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Active Alert Level Banner -->
                    <TextView
                        android:id="@+id/tvAlertLevelBadge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Monitoring distance en route"
                        android:textSize="12sp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="@color/text_muted"
                        android:background="@color/surface_elevated" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. DESTINATION SELECTION & PRESETS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT DESTINATION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_secondary" />

                    <!-- Destination Selection Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenMapPicker"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Pick on Map"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/white"
                            app:icon="@drawable/ic_location"
                            app:iconGravity="textStart"
                            app:iconPadding="6dp"
                            app:iconTint="@color/white"
                            app:cornerRadius="10dp"
                            android:layout_marginEnd="8dp"
                            android:backgroundTint="@color/primary_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportLink"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="Paste Link"
                            android:textSize="13sp"
                            android:textColor="@color/accent"
                            app:cornerRadius="10dp"
                            app:strokeColor="@color/card_stroke"
                            app:strokeWidth="1dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                    <!-- Landmark Confirmation Preview Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLandmarkConfirmation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:visibility="gone"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/status_green"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/status_green_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/status_green_text"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="Verified Landmark Icon" />

                            <TextView
                                android:id="@+id/tvLandmarkConfirmation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_green_text" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Destination Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Selected Destination Name"
                        app:helperText="Edit this for custom voice announcements (e.g. 'Home')"
                        app:helperTextTextColor="@color/text_secondary"
                        app:boxStrokeColor="@color/primary_light"
                        app:hintTextColor="@color/primary_light"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDestName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Latitude Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Latitude"
                        app:boxStrokeColor="@color/primary_light"
                        app:hintTextColor="@color/primary_light"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLatitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:inputType="numberDecimal|numberSigned" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Longitude Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Longitude"
                        app:boxStrokeColor="@color/primary_light"
                        app:hintTextColor="@color/primary_light"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLongitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:inputType="numberDecimal|numberSigned" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. VOICE LANGUAGE SETTINGS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOICE ALERT LANGUAGE (REGIONAL TTS)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangEnglish"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="English"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/primary_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangTamil"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="தமிழ்"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            android:layout_marginEnd="6dp"
                            app:strokeColor="@color/card_stroke"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangHindi"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="हिन्दी"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary"
                            app:strokeColor="@color/card_stroke"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 4. MULTI-LEVEL ALERT BREAKDOWN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROGRESSIVE ALERT STAGES"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="12dp" />

                    <!-- Level 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="5.0 km"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:fontFamily="monospace"
                            android:textColor="@color/status_green_text"
                            android:background="@color/status_green_bg"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="10dp" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="36dp"
                            android:background="@color/status_green"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LEVEL 1 — SILENT"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:textColor="@color/status_green_text" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Wake-up notification"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Level 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="2.0 km"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:fontFamily="monospace"
                            android:textColor="@color/status_amber_text"
                            android:background="@color/status_amber_bg"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="10dp" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="36dp"
                            android:background="@color/status_amber"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LEVEL 2 — VIBRATE"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:textColor="@color/status_amber_text" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pack your bags now"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Level 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="1.0 km"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:fontFamily="monospace"
                            android:textColor="@color/status_violet_text"
                            android:background="@color/status_violet_bg"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="10dp" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="36dp"
                            android:background="@color/status_violet"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LEVEL 3 — VOICE"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:textColor="@color/status_violet_text" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Regional TTS announcement"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- Level 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="52dp"
                            android:layout_height="wrap_content"
                            android:text="0.5 km"
                            android:textStyle="bold"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:fontFamily="monospace"
                            android:textColor="@color/status_red_text"
                            android:background="@color/status_red_bg"
                            android:paddingHorizontal="4dp"
                            android:paddingVertical="3dp"
                            android:layout_marginEnd="10dp" />

                        <View
                            android:layout_width="3dp"
                            android:layout_height="36dp"
                            android:background="@color/status_red"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LEVEL 4 — SIREN"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:textColor="@color/status_red_text" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Full wake alarm + max volume"
                                android:textSize="12sp"
                                android:textColor="@color/text_secondary" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 5. ACTION BUTTONS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTracking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start Destination Alarm"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                app:icon="@drawable/ic_alarm"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/white"
                app:cornerRadius="14dp"
                android:elevation="6dp"
                android:backgroundTint="@color/primary_light" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopTracking"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Stop Tracking"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/status_red_text"
                app:cornerRadius="14dp"
                android:elevation="4dp"
                android:visibility="gone"
                app:strokeColor="@color/status_red"
                app:strokeWidth="1dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />


            <View
