<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/background_light">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        app:elevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_alarm"
                app:tint="@color/white"
                android:layout_marginEnd="12dp"
                android:contentDescription="Alarm Icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Offline Destination &amp; Sleep Alert"
                    android:textSize="12sp"
                    android:textColor="#93C5FD" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. LIVE TRACKING STATUS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardTrackingStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/statusIndicator"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/ic_alarm"
                            android:backgroundTint="@color/text_muted"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:id="@+id/tvStatusHeader"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LIVE STATUS"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.05"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvApproachBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Idle"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:textColor="@color/text_secondary"
                            android:background="@color/background_light" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="GPS Idle — Tap Start to track in background"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Distance to stop: -- km"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_light" />

                    <!-- Speed & ETA telemetry row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <TextView
                            android:id="@+id/tvSpeed"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Speed: -- km/h"
                            android:textSize="13sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tvEta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ETA: --"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 2. DESTINATION SELECTION & PRESETS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECT DESTINATION"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_secondary" />

                    <!-- Destination Selection Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenMapPicker"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="🔍 Pick on Map"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_location"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:cornerRadius="12dp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/primary_light" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnImportLink"
                            android:layout_width="0dp"
                            android:layout_height="52dp"
                            android:layout_weight="1"
                            android:text="📥 Paste Link"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            app:icon="@drawable/ic_alarm"
                            app:iconGravity="textStart"
                            app:iconPadding="4dp"
                            app:cornerRadius="12dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                    </LinearLayout>

                    <!-- Landmark Confirmation Preview Badge -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardLandmarkConfirmation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/status_green"
                        app:strokeWidth="1dp"
                        app:cardBackgroundColor="@color/status_green_bg">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_location"
                                app:tint="@color/status_green_text"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="Verified Landmark Icon" />

                            <TextView
                                android:id="@+id/tvLandmarkConfirmation"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="📍 Verified: Near Madurai Junction Clock Tower"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/status_green_text" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Quick Preset Chips -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="QUICK PRESETS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_muted" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginTop="6dp"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:id="@+id/presetsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipMadurai"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:text="🚆 Madurai Junction"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipCentral"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:text="🚆 Chennai Central"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipAirport"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:text="✈️ Chennai Airport"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp"
                                android:layout_marginEnd="8dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/chipCoimbatore"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:text="🚆 Coimbatore"
                                android:textSize="12sp"
                                android:paddingHorizontal="12dp" />

                        </LinearLayout>

                    </HorizontalScrollView>

                    <!-- Destination Name Input -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Selected Destination Name"
                        app:boxStrokeColor="@color/primary_light"
                        app:hintTextColor="@color/primary_light"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDestName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Madurai Junction"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Latitude Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Latitude"
                        app:boxStrokeColor="@color/primary_light"
                        app:hintTextColor="@color/primary_light"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLatitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="9.9196"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:inputType="numberDecimal|numberSigned" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Longitude Field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:hint="Longitude"
                        app:boxStrokeColor="@color/primary_light"
                        app:hintTextColor="@color/primary_light"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etLongitude"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="78.1100"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:inputType="numberDecimal|numberSigned" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. VOICE LANGUAGE SETTINGS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VOICE ALERT LANGUAGE (REGIONAL TTS)"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_secondary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangEnglish"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="English"
                            android:textSize="12sp"
                            android:layout_marginEnd="6dp"
                            android:backgroundTint="@color/primary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangTamil"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="தமிழ்"
                            android:textSize="12sp"
                            android:layout_marginEnd="6dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLangHindi"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:text="हिन्दी"
                            android:textSize="12sp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 4. MULTI-LEVEL ALERT BREAKDOWN -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface_card"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROGRESSIVE ALERT STAGES"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.05"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="12dp" />

                    <!-- Level 1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="5.0 km"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/status_green_text"
                            android:background="@color/status_green_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Level 1: Silent Notification (Wake up)"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <!-- Level 2 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2.0 km"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/status_amber_text"
                            android:background="@color/status_amber_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Level 2: Vibration Pulse (Pack bags)"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <!-- Level 3 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.0 km"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="#4338CA"
                            android:background="#E0E7FF"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Level 3: Voice TTS in Selected Language"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                    <!-- Level 4 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="4dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.5 km"
                            android:textStyle="bold"
                            android:textSize="12sp"
                            android:textColor="@color/status_red_text"
                            android:background="@color/status_red_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Level 4: Full Wake Alarm &amp; Max Ringtone"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 5. ACTION BUTTONS -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleTracking"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Start Background Destination Alarm"
                android:textSize="15sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_alarm"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:cornerRadius="14dp"
                android:elevation="4dp"
                android:backgroundTint="@color/primary" />

            <!-- Test / Preview Alarm Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestAlarm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="🧪 Test Alarm Siren, Voice &amp; Screen"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:textColor="@color/primary"
                app:strokeColor="@color/primary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
